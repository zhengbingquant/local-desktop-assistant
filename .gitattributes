# Normalize line endings: store as LF in the repo, check out as native (CRLF on Windows).
* text=auto

# Explicitly mark text files.
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary files.
*.gguf binary
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
